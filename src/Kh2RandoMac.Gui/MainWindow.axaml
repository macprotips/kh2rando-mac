<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Kh2RandoMac.Gui.MainWindow"
        Title="KH2 Rando Manager"
        Width="1200" Height="880"
        MinWidth="960" MinHeight="800">

  <Window.Styles>
    <!-- Hairline between button groups, so related controls read as a set. -->
    <Style Selector="Border.divider">
      <Setter Property="Width" Value="1"/>
      <Setter Property="Background" Value="#26FFFFFF"/>
      <Setter Property="Margin" Value="3,5"/>
    </Style>
    <!-- Reorder controls repeat on every row; keep them quiet until hovered. -->
    <Style Selector="Button.reorder">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#A6FFFFFF"/>
      <Setter Property="Padding" Value="9,5"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Button.reorder:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#22FFFFFF"/>
    </Style>
    <!-- Destructive actions get a warm tint so they are never confused with routine ones. -->
    <!-- A secondary action that belongs beside its value rather than competing with it.
         Quiet until hovered, like the reorder controls on the mod rows. -->
    <Style Selector="Button.icon">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="7,5"/>
      <Setter Property="CornerRadius" Value="5"/>
    </Style>
    <Style Selector="Button.icon /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1FFFFFFF"/>
    </Style>
    <Style Selector="Button.icon Path">
      <Setter Property="Fill" Value="#8AFFFFFF"/>
    </Style>
    <Style Selector="Button.icon:pointerover Path">
      <Setter Property="Fill" Value="#F2FFFFFF"/>
    </Style>

    <!-- For a setting that is currently wrong in a way that costs someone their run,
         rather than merely being off. -->
    <Style Selector="Button.warning">
      <Setter Property="Foreground" Value="#FFB454"/>
      <Setter Property="BorderBrush" Value="#66FFB454"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.destructive">
      <Setter Property="Foreground" Value="#FF8A80"/>
    </Style>
    <Style Selector="TextBlock.sectionlabel">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Opacity" Value="0.55"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Styles>

  <Grid x:Name="RootGrid" Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>                <!-- status header -->
      <RowDefinition Height="Auto"/>                <!-- install row -->
      <RowDefinition Height="Auto"/>                <!-- load order label -->
      <!-- The mod list is what the window is for, so it takes the slack and keeps a
           floor: shrinking the window used to come out of it alone, because the log
           below held a fixed height and gave nothing back. -->
      <RowDefinition Height="*" MinHeight="132"/>   <!-- mod list -->
      <RowDefinition Height="Auto"/>                <!-- splitter -->
      <RowDefinition Height="128" MinHeight="60"/>  <!-- log, dragged by the splitter -->
      <RowDefinition Height="Auto"/>                <!-- build actions -->
      <RowDefinition Height="Auto"/>                <!-- version -->
    </Grid.RowDefinitions>

    <!-- Status header: what the app knows, plus the setup and upkeep actions -->
    <Border Grid.Row="0" Background="#22FFFFFF" CornerRadius="10" Padding="20,14" Margin="0,0,0,12">
      <StackPanel Spacing="10">
        <StackPanel Spacing="9">
          <!-- Trailing Auto column is local to this row; the badge and label columns
               match the rows below so the left edges still line up. -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="30"/>
              <ColumnDefinition Width="96"/>
              <!-- Sized to the text so the folder glyph lands right after it. Left to
                   fill the window, the glyph sat at the far edge with a stretch of
                   nothing between it and the value it acts on. The cap keeps a long
                   game path from running the whole width. -->
              <ColumnDefinition Width="Auto" MaxWidth="560"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="GameStatusBadge" Width="20" Height="20" CornerRadius="10"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
              <TextBlock x:Name="GameStatusIcon" FontSize="11" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Grid.Column="1" Text="Game" FontSize="13" FontWeight="SemiBold"
                       VerticalAlignment="Top" Margin="0,1,0,0"/>
            <StackPanel Grid.Column="2" Spacing="2">
              <TextBlock x:Name="GameStatusText" FontSize="13" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal" Spacing="7">
                <TextBlock x:Name="GamePathText" FontSize="11" Opacity="0.45"
                           MaxWidth="520" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" IsVisible="False"/>
                <Button x:Name="ChangeGameButton" Classes="icon" Click="OnChangeGameFolder"
                        ToolTip.Tip="Choose a different copy of the game, then set up the mod loader in it. Quit Steam and the game first.">
                  <Path Width="15" Height="15" Stretch="Uniform" Data="M1,3.6 L6.1,3.6 L7.6,5.6 L15,5.6 L15,13.2 L1,13.2 Z"/>
                </Button>
              </StackPanel>
            </StackPanel>
          </Grid>
          <Grid ColumnDefinitions="30,96,*">
            <Border x:Name="LoaderStatusBadge" Width="20" Height="20" CornerRadius="10"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
              <TextBlock x:Name="LoaderStatusIcon" FontSize="11" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Grid.Column="1" Text="Mod loader" FontSize="13" FontWeight="SemiBold"
                       VerticalAlignment="Top" Margin="0,1,0,0"/>
            <TextBlock Grid.Column="2" x:Name="LoaderStatusText" FontSize="13" TextWrapping="Wrap"/>
          </Grid>
          <Grid ColumnDefinitions="30,96,*">
            <Border x:Name="DataStatusBadge" Width="20" Height="20" CornerRadius="10"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
              <TextBlock x:Name="DataStatusIcon" FontSize="11" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Grid.Column="1" Text="Game data" FontSize="13" FontWeight="SemiBold"
                       VerticalAlignment="Top" Margin="0,1,0,0"/>
            <TextBlock Grid.Column="2" x:Name="DataStatusText" FontSize="13" TextWrapping="Wrap"/>
          </Grid>
          <!-- The workspace holds the extracted game data, about 30 GB of it, so where
               it lives is a real decision on a Mac with a small disk. -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="30"/>
              <ColumnDefinition Width="96"/>
              <ColumnDefinition Width="Auto" MaxWidth="560"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="Files" FontSize="13" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7"
                        VerticalAlignment="Center">
              <TextBlock x:Name="WorkspaceText" FontSize="12" Opacity="0.75"
                         MaxWidth="520" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"/>
              <Button x:Name="ChangeWorkspaceButton" Classes="icon" Click="OnChangeWorkspace"
                      ToolTip.Tip="Choose where mods, the extracted game data and the built mods are kept. The extraction alone is about 30 GB, so an external drive is a reasonable place for it.">
                <Path Width="15" Height="15" Stretch="Uniform" Data="M1,3.6 L6.1,3.6 L7.6,5.6 L15,5.6 L15,13.2 L1,13.2 Z"/>
              </Button>
            </StackPanel>
          </Grid>
          <!-- Shown whenever there is a bottle, including when there is only one: this
               is where someone looks to find out which bottle the game is in, and how to
               change it. Switching is a real operation, not a preference, since a bottle
               carries its own mod loader. -->
          <Grid x:Name="BottleRow" ColumnDefinitions="30,96,*" IsVisible="False">
            <TextBlock Grid.Column="1" Text="Bottle" FontSize="13" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <ComboBox Grid.Column="2" x:Name="BottlePicker" FontSize="12"
                      HorizontalAlignment="Left" MinWidth="240"
                      ToolTip.Tip="Which CrossOver bottle the game is modded in. Pick another to move it there; that bottle gets its own mod loader and runtimes, which takes a few minutes. Make bottles in CrossOver."/>
          </Grid>
          <!-- Only shown when more than one CrossOver is installed; they share bottles,
               and a bottle can only be run by a copy its own age or newer. -->
          <!-- First column is fixed to the badge width (20 plus its 10 margin) so this
               label lines up with the ones beside a badge, not with the badges. -->
          <Grid x:Name="CrossOverRow" ColumnDefinitions="30,96,*" IsVisible="False">
            <TextBlock Grid.Column="1" Text="CrossOver" FontSize="13" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <ComboBox Grid.Column="2" x:Name="CrossOverPicker" FontSize="12"
                      HorizontalAlignment="Left" MinWidth="240"
                      ToolTip.Tip="You have more than one CrossOver installed and they share bottles. The app picks the right one for your bottle; change it here if you want a specific copy."/>
          </Grid>
        </StackPanel>

        <Border Height="1" Background="#1AFFFFFF" Margin="0,3,0,0"/>

        <!-- Their own row rather than a column beside the status: as a column they were
             centred against the block as a whole, so they lined up with whichever row
             happened to be in the middle, and they took the width the paths needed.
             Right-aligned to match the row of actions above the log, so both sets of
             buttons sit on one edge rather than each finding their own.
             Grouped left to right: one-time setup, upkeep, then diagnostics and the
             destructive action furthest from everything else. -->
        <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Right">
          <Button x:Name="SetupButton" Content="Run Setup" Click="OnSetup"
                  ToolTip.Tip="Finds your game, installs Panacea and LuaBackend, configures the bottle, and installs the .NET runtimes the item tracker and Re:Fined need. Takes several minutes. Quit Steam and the game first."/>
          <Button x:Name="ExtractButton" Content="Extract Game Data" Click="OnExtract"
                  ToolTip.Tip="Unpacks the game's files so mods can be built against them. Takes 10 to 20 minutes and about 30 GB. Run it again after a game update."/>
          <Border Classes="divider"/>
          <Button x:Name="UpdatesButton" Content="Check Updates" Click="OnCheckUpdates"
                  ToolTip.Tip="Updates mods installed from GitHub to their latest version."/>
          <Button x:Name="RefreshButton" Content="Refresh" Click="OnRefresh"
                  ToolTip.Tip="Re-checks the game, mod loader, and mod list."/>
          <Border Classes="divider"/>
          <Button x:Name="LogButton" Content="Log" Click="OnRevealLog"
                  ToolTip.Tip="Shows the app's log file in Finder. Attach it to bug reports."/>
          <Button x:Name="ResetButton" Classes="destructive" Content="Reset…" Click="OnReset"
                  ToolTip.Tip="Returns the game to vanilla: removes Panacea, LuaBackend, and the bottle changes. Mods and seeds are kept; you choose whether the extracted game data goes too."/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Install row: type-anything installs on the left, curated one-click installs on the right -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" Margin="0,0,0,18">
      <TextBox x:Name="RepoBox" Grid.Column="0"
               Watermark="GitHub mod (author/repo), or drag files in…"
               ToolTip.Tip="A GitHub mod in author/repo form, for example KH2FM-Mods-Num/GoA-ROM-Edition."/>
      <Button x:Name="InstallGitButton" Grid.Column="1" Content="Install from GitHub" Margin="8,0,0,0" Click="OnInstallGit"
              ToolTip.Tip="Downloads and enables the mod named on the left."/>
      <Button x:Name="InstallZipButton" Grid.Column="2" Content="Install Mod / Seed File…" Margin="6,0,0,0" Click="OnInstallZip"
              ToolTip.Tip="Installs a seed zip, mod zip, .kh2pcpatch, or .lua script. Dragging files onto the window does the same."/>
      <Border Grid.Column="3" Classes="divider" Margin="9,2"/>
      <!-- The star sits in its own sized TextBlock: as button Content the emoji's
           taller line metrics stretch the button out of line with its neighbour. -->
      <Button x:Name="InstallGoaButton" Grid.Column="4" MinWidth="152" HorizontalContentAlignment="Center" Click="OnInstallGoa"
              ToolTip.Tip="Installs Garden of Assemblage, the base mod every randomizer seed needs.">
        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
          <TextBlock Text="⭐" FontSize="11" VerticalAlignment="Center"/>
          <TextBlock Text="Install GoA" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
      <Button x:Name="InstallRefinedButton" Grid.Column="5" MinWidth="152" HorizontalContentAlignment="Center" Content="Install Re:Fined" Margin="6,0,0,0" Click="OnInstallRefined"
              ToolTip.Tip="Installs Re:Fined, a quality-of-life overhaul with skippable cutscenes, soft reset, and a prologue skip. Works on its own or alongside a seed. Large download."/>
    </Grid>

    <!-- List header: names the list and carries its live tally -->
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="2,0,2,9">
      <TextBlock Grid.Column="0" Text="Load order" FontSize="12" FontWeight="SemiBold" Opacity="0.8"
                 VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" Classes="sectionlabel" Margin="10,0,10,0"
                 Text="Mods at the top win conflicts. Build after any change."
                 TextTrimming="CharacterEllipsis"/>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock x:Name="ModCountText" Classes="sectionlabel"/>
        <Button x:Name="ExportButton" Content="Export…" FontSize="11" Padding="10,3" Click="OnExportMods"
                ToolTip.Tip="Copies every installed mod and the load order into a folder you choose, for a backup or to share your setup."/>
      </StackPanel>
    </Grid>

    <!-- Mod list -->
    <Border Grid.Row="3" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="8">
      <ScrollViewer>
        <ItemsControl x:Name="ModList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Padding="14,11" BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto">
                  <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Enabled mods are included in the next build."/>
                  <StackPanel Grid.Column="1" Margin="10,0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.6"/>
                    <!-- Confirmed problems belong on the row, where they are read before
                         building, not only in the log afterwards. -->
                    <TextBlock Text="{Binding Issue}" IsVisible="{Binding HasIssue}"
                               FontSize="11" Foreground="#FFB454" TextWrapping="Wrap"
                               MaxWidth="620" Margin="0,2,0,0"/>
                  </StackPanel>
                  <Button Grid.Column="2" Classes="reorder" Content="Top"
                          Click="OnMoveToTop" Tag="{Binding}"
                          ToolTip.Tip="Move to the top."/>
                  <Button Grid.Column="3" Classes="reorder" Content="▲"
                          Click="OnMoveUp" Tag="{Binding}"
                          ToolTip.Tip="Move up."/>
                  <Button Grid.Column="4" Classes="reorder" Content="▼"
                          Click="OnMoveDown" Tag="{Binding}"
                          ToolTip.Tip="Move down."/>
                  <Button Grid.Column="5" Classes="reorder" Content="Bottom"
                          Click="OnMoveToBottom" Tag="{Binding}"
                          ToolTip.Tip="Move to the bottom."/>
                  <Border Grid.Column="6" Classes="divider" Margin="6,4"/>
                  <Button Grid.Column="7" Classes="reorder destructive" Content="Remove"
                          Click="OnRemoveMod" Tag="{Binding}"
                          ToolTip.Tip="Uninstalls this mod."/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- Action row, grouped: game settings, external tools, then the primary build actions -->
    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="7" Margin="0,16,0,16">
      <Button x:Name="HudButton" Content="FPS HUD: Off" Padding="14,8"
              Click="OnToggleHud"
              ToolTip.Tip="Shows an FPS overlay in the game. Quit CrossOver and Steam before turning it on."/>
      <Button x:Name="MoviesButton" Content="Movies: On" Padding="14,8"
              Click="OnToggleMovies"
              ToolTip.Tip="Movie cutscenes crash the game under CrossOver. Skipping them avoids the crash. Click again to put them back."/>
      <Border Classes="divider" Margin="6,4"/>
      <Button x:Name="SeedGenButton" Content="Seed Generator" Padding="14,8"
              Click="OnOpenSeedGenerator"
              ToolTip.Tip="Opens the KH2 Randomizer seed generator. The first click installs it, which takes a few minutes."/>
      <Border Classes="divider" Margin="6,4"/>
      <Button x:Name="TrackerButton" Content="Tracker" Padding="14,8"
              Click="OnTracker"
              ToolTip.Tip="Opens the KH2 item tracker. If Setup has not already installed what it needs, the first click does, which can take ten minutes. Quit Steam and the game first."/>
      <Border Classes="divider" Margin="6,4"/>
      <Button x:Name="BuildButton" Content="Build" FontWeight="SemiBold" Padding="18,8"
              Click="OnBuild"
              ToolTip.Tip="Applies the enabled mods to the game. Run it after any change to the list."/>
      <Button x:Name="RunButton" Content="Build &amp; Run" FontWeight="SemiBold"
              Classes="accent" Padding="18,8" Click="OnBuildRun"
              ToolTip.Tip="Builds, then launches the game through CrossOver."/>
    </StackPanel>

    <!-- Log, with a progress strip above it while something is running. Setup pulls
         down a few hundred MB and runs installers inside the bottle; without this the
         window looks frozen for minutes at a time. -->
    <!-- Drag to trade space between the list and the log. The bar is the visible part
         and the splitter over it is the wider target, since a three-pixel line is
         something you hunt for rather than grab. -->
    <Border Grid.Row="4" Height="3" Width="52" CornerRadius="2" Background="#2EFFFFFF"
            HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <GridSplitter Grid.Row="4" Height="11" Background="Transparent"
                  HorizontalAlignment="Stretch" ResizeDirection="Rows"
                  ResizeBehavior="PreviousAndNext"
                  ToolTip.Tip="Drag to make the mod list or the log taller."/>

    <Border Grid.Row="5" Background="#181818" CornerRadius="8" Padding="8">
      <Grid RowDefinitions="Auto,*">
        <Grid x:Name="ProgressRow" ColumnDefinitions="*,Auto" IsVisible="False" Margin="0,1,0,8">
          <StackPanel Spacing="5">
            <TextBlock x:Name="ProgressLabel" FontSize="11" Foreground="#D8FFFFFF"
                       TextTrimming="CharacterEllipsis"/>
            <ProgressBar x:Name="TaskProgress" Height="3" Minimum="0" Maximum="100"
                         IsIndeterminate="True"/>
          </StackPanel>
          <TextBlock Grid.Column="1" x:Name="ProgressPercent" FontSize="11" Opacity="0.55"
                     VerticalAlignment="Center" Margin="10,0,2,0"/>
        </Grid>
        <ScrollViewer Grid.Row="1" x:Name="LogScroll">
          <TextBlock x:Name="LogText" FontFamily="Menlo, monospace" FontSize="11"
                     TextWrapping="Wrap" Text="Ready."/>
        </ScrollViewer>
      </Grid>
    </Border>

    <TextBlock x:Name="VersionText" Grid.Row="7" HorizontalAlignment="Right"
               Margin="0,6,2,0" FontSize="11" Opacity="0.4"/>
  </Grid>
</Window>
